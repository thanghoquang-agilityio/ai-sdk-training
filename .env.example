# Default provider: Ollama (local free mode)
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=gemma3:4b
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1

# Optional: switch to OpenAI chat
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# NEXT_PUBLIC_OPENAI_SERVER_READY=true
# NEXT_PUBLIC_MOCK_PRODUCTION=true

# Optional: image model (OpenAI only in this project)
# OPENAI_IMAGE_MODEL=gpt-image-1

# Optional: Slack reminder tokens
# Prefer user-context reminder (/remind list) with user token.
# Recommended user scopes: reminders:write, reminders:read, channels:write, groups:write, im:write, mpim:write, post
# SLACK_USER_TOKEN=xoxp-your-slack-user-token
# Fallback bot schedule mode:
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# SLACK_REMINDER_UTC_OFFSET=+07:00
# SLACK_DEFAULT_CHANNEL=C12345678

# Production note:
# - OpenAI is the default provider in production.
# - If AI_PROVIDER=ollama in production, prefer entering ollamaBaseUrl from UI.
# - Optional env defaults:
#   OPENAI_BASE_URL=https://your-ollama-host/v1
#   OLLAMA_TAGS_ENDPOINT=https://your-ollama-host/api/tags

# Optional: company system server (json-server) URL for server-side CRUD
# COMPANY_SYSTEM_BASE_URL=http://127.0.0.1:4100
# COMPANY_SYSTEM_HOST=127.0.0.1
# COMPANY_SYSTEM_PORT=4100

# Optional: agent runtime tuning (Flash-agent inspired)
# AGENT_STOP_STEP_COUNT=6
# AGENT_TEMPERATURE=0.2
# AGENT_MESSAGE_WINDOW=14
# AGENT_MAX_RETRIES=2
# AGENT_MAX_OUTPUT_TOKENS=1200
# AGENT_RUN_STATS_LOG=1
# Legacy alias (still supported): AGENT_TELEMETRY_LOG=1
