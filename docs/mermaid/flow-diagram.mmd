flowchart RL
 subgraph USER_PHASE["Interaction"]
    direction LR
        U["👤<br><b>User</b>"]
        API["☁️<br><b>Next.js API</b><br>/api/chat"]
  end
 subgraph ORCH_PHASE["Orchestration"]
    direction TB
        COORD["🎯<br><b>Coordinator</b><br>chat-core/coordinator"]
        AUTH["🔐<br><b>Auth Guard</b><br>Role verification"]
  end
 subgraph AGENT_PHASE["Specialists"]
    direction LR
        MGR_AGENT["👔<br><b>Manager Agent</b><br>runManagerAgent"]
        EMP_AGENT["👷<br><b>Employee Agent</b><br>runEmployeeAgent"]
  end
 subgraph TOOL_PHASE["Execution"]
    direction LR
        T_SLACK["📖 Read / ✏️ Write<br>Slack Service"]
        T_COMP["📖 Read / ✏️ Write<br>Company System"]
  end
    U -- Send Message --> API
    API -- Authenticate --> AUTH
    AUTH -- Route by Role/Intent --> COORD
    COORD -- Assign Specialist --> AGENT_PHASE
    AGENT_PHASE -- Tool Call --> TOOL_PHASE
    TOOL_PHASE -- Respond --> AGENT_PHASE
    AGENT_PHASE -- Stream Response --> API
    API -- SSE / JSON --> U
    AUTH ~~~ U

    U@{ shape: rect}
    API@{ shape: rect}
    COORD@{ shape: rect}
    AUTH@{ shape: rect}
    MGR_AGENT@{ shape: rect}
    EMP_AGENT@{ shape: rect}
    T_SLACK@{ shape: rect}
    T_COMP@{ shape: rect}
     U:::actor
     API:::orchestrator
     COORD:::coord
     AUTH:::idp
     MGR_AGENT:::agent
     EMP_AGENT:::agent
     T_SLACK:::tool
     T_COMP:::tool
